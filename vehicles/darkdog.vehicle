<?xml version="1.0" encoding="utf-8"?>
<vehicle file="vehicle_base.vehicle" name="Darkdog" key="darkdog.vehicle"
    respawn_time="36000" time_to_live_unsteerable="95" map_view_atlas_index="60"
    minimum_fill_requirement="0.0" max_character_collision_speed_on_normal="8.0"
    owner="faction" allow_owner_to_use_only="1" allow_ai_to_use="1">
    <tag name="metal_heavy" />
    <tag name="heavy_combat" />
    <tag name="any_tank" />
    <tag name="boss" />
    <tag name="darkdog" />
    <!-- Spawn with /darkdog; no generic tank tag or faction-pool replacement. -->
    <!-- Legion-style three-pair support, centred on the running gear at Z=-0.18.
         The physical frame follows these supports, not the full visual hull. -->
    <tire_set offset="1.75 0.0 3.0" radius="0.63" />
    <tire_set offset="1.75 0.0 -0.18" radius="0.63" />
    <tire_set offset="1.75 0.0 -3.36" radius="0.63" />
    <control max_speed="16.0" acceleration="15.0" max_reverse_speed="10.0"
        min_health_to_steer="0.0" max_rotation="0.0" max_water_depth="1.6"
        steer_smoothening="0.98" tracked="1" gears="1" max_limiter_speed="6.0"
        simulated_speed_factor="0.5" />
    <!-- DarkCat durability; Legion mass and lower physical top reference.
         The collision box remains the source object's full-size hit volume. -->
    <physics max_health="40.0" blast_damage_threshold="0.17" mass="1200.0"
        broken_mass="10" remove_collision_threshold="0.2"
        extent="3.8 0.0 6.8" offset="0 0 -0.18" top_offset="0 2.0 0"
        collision_model_pos="0 1.143257 0.098557"
        collision_model_extent="4.816670 2.418247 9.018196" visual_offset="0 0.6 0" />

    <!-- Visible mounts occupy indices 0 and 1. Both have a TOTAL 140-degree arc.
         Turret 2's mesh is exported in forward-local coordinates and rotated
         180 degrees here, so its neutral direction is the back of the hull. -->
    <turret offset="0.000002 2.157822 1.149593" weapon_key="darkdog_cannon.weapon"
        weapon_offset="-0.019713 0.365229 4.882076" weapon_recoil="0" physics_recoil="0"
        rotation="0" rotation_range="2.443461" max_rotation_step="0.0001" aim_shoot_threshold="0.9" />
    <turret offset="0 2.422212 -2.350000" weapon_key="darkdog_minigun.weapon"
        weapon_offset="0 0 0" weapon_recoil="0" physics_recoil="0"
        rotation="3.141593" rotation_range="2.443461" max_rotation_step="0.0002" />

    <!-- Fixed child emitters rotate with their parent. All offsets below are
         parent-local, obtained from the six named EMPTY objects in the blend.
         Weapons are already part of the turret mesh; they have no extra model. -->
    <turret offset="0 0 0" parent_turret_index="0" weapon_key="darkdog_20mm.weapon"
        weapon_offset="0.204377 0.365229 3.995065" weapon_recoil="0" physics_recoil="0"
        rotation="0" rotation_range="0" max_rotation_step="0" />
    <turret offset="0 0 0" parent_turret_index="0" weapon_key="darkdog_missile.weapon"
        weapon_offset="1.340369 0.325807 1.491726" weapon_recoil="0" physics_recoil="0"
        rotation="0" rotation_range="0" max_rotation_step="0" />
    <turret offset="0 0 0" parent_turret_index="0" weapon_key="darkdog_missile.weapon"
        weapon_offset="-1.340372 0.325807 1.491727" weapon_recoil="0" physics_recoil="0"
        rotation="0" rotation_range="0" max_rotation_step="0" />
    <turret offset="0 0 0" parent_turret_index="1" weapon_key="darkdog_hive.weapon"
        weapon_offset="1.261525 0.771024 0.015361" weapon_recoil="0" physics_recoil="0"
        rotation="0" rotation_range="0" max_rotation_step="0" />

    <visual class="chassis" mesh_filename="darkdog_body.mesh" texture_filename="darkdog_wf_v2.png" max_tilt="0.04" />
    <visual class="chassis" key="broken" mesh_filename="darkdog_body.mesh" texture_filename="darkdog_wf_v2.png" />
    <visual class="turret" turret_index="0" mesh_filename="darkdog_turret1.mesh" texture_filename="darkdog_wf_v2.png" />
    <visual class="turret" turret_index="1" mesh_filename="darkdog_turret2.mesh" texture_filename="darkdog_wf_v2.png" />
    <visual class="turret" turret_index="0" key="broken" mesh_filename="darkdog_turret1.mesh" texture_filename="darkdog_wf_v2.png" />
    <visual class="turret" turret_index="1" key="broken" mesh_filename="darkdog_turret2.mesh" texture_filename="darkdog_wf_v2.png" />
    <visual class="track" mesh_filename="darkdog_track_left.mesh">
        <part texture_filename="aav7_track.png" texture_animation="translate" tire_binding="0" />
    </visual>
    <visual class="track" mesh_filename="darkdog_track_right.mesh">
        <part texture_filename="aav7_track.png" texture_animation="translate" tire_binding="1" />
    </visual>
    <visual class="track" mesh_filename="darkdog_wheel_left.mesh">
        <part texture_filename="aav7_wheel.png" texture_animation="rotate" tire_binding="0" />
    </visual>
    <visual class="track" mesh_filename="darkdog_wheel_right.mesh">
        <part texture_filename="aav7_wheel.png" texture_animation="rotate" tire_binding="1" />
    </visual>

    <character_slot type="driver" enter_position="2.9 0.5 3.5" seat_position="1 1.0 3.0"
        rotation="0" exit_rotation="1.570796" hiding="1" animation_id="36" />
    <character_slot type="gunner" enter_position="-2.9 0.5 1.15" seat_position="0 1.5 1.15"
        rotation="0" exit_rotation="-1.570796" hiding="1" animation_id="37">
        <turret index="0" />
        <turret index="2" />
        <turret index="3" />
        <turret index="4" />
    </character_slot>
    <character_slot type="gunner" enter_position="2.9 0.5 -2.35" seat_position="0 1.5 -2.35"
        rotation="3.141593" exit_rotation="1.570796" hiding="1" animation_id="37">
        <turret index="1" />
        <turret index="5" />
    </character_slot>

    <rev_sound filename="tank_rev0.wav" low_pitch="0.4" high_pitch="0.5" low_rev="0.0" high_rev="1.0" volume="0.9" />
    <rev_sound filename="tank_rev0_b.wav" low_pitch="0.6" high_pitch="0.7" low_rev="0.0" high_rev="1.0" volume="0.6" />
    <rev_sound filename="tank_rev1.wav" low_pitch="0.2" high_pitch="0.4" low_rev="0.4" high_rev="0.7" volume="1.0" />
    <rev_sound filename="tank_tracks.wav" low_pitch="0.4" high_pitch="0.8" low_rev="0.1" high_rev="1.0" volume="0.9" />
    <rev_sound filename="tank_rev2.wav" low_pitch="0.3" high_pitch="0.5" low_rev="0.9" high_rev="1.0" volume="0.9" />
    <sound key="squeal" filename="tire_squeal.wav" />
    <sound key="ignition" filename="jeep2_ignition.wav" />
    <sound key="hit" filename="car_hit1.wav" />
    <sound key="hit" filename="car_hit2.wav" />
    <sound key="destroy" filename="vehicle_explosion_1.wav" />
    <sound key="cleanup" filename="vehicle_explosion_1.wav" />
    <sound key="turret_rotation" filename="turret_rotation1.wav" volume="0.8" />
    <sound key="turret_rotation" filename="turret_rotation2.wav" volume="0.8" />
    <effect event_key="drive" type="splat_map" surface_tag="dirt" size="1.0" atlas_index="2" layer="1" />
    <effect event_key="drive" type="particle" key="terrain" surface_tag="dirt" ref="Burst" use_surface_color="1" />
    <effect event_key="health" value="8.0" ref="SmallSmokeVehicle" offset="0 2.4 -3.1" />
    <effect event_key="health" value="2.0" ref="BrokenSparkle" post_processing="0" offset="0 2.4 -3.1" />
    <effect event_key="destroyed" ref="SmallSmokeVehicle" offset="0 2.4 -3.1" />
    <effect event_key="destroyed" ref="MediumSmokeVehicle" offset="0 3.2 0.5" />
    <effect event_key="destroyed" ref="SmallFireRepeat" offset="0 2.4 -3.1" />
    <effect event_key="destroy" key="other" ref="woosh_big" post_processing="0" shadow="0" />
    <effect event_key="cleanup" key="other" ref="woosh_big" post_processing="0" shadow="0" />
</vehicle>
